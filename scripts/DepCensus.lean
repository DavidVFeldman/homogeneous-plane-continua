import HPC
import HPCExtra
import HPCArchive
import HPCCensus

/-!
# Dependency census of the classification (batch 203)

Run from the repository root, after `lake build HPC HPCExtra HPCArchive HPCCensus`:

```
lake env lean scripts/DepCensus.lean
```

The program reads the environment of the four libraries and writes the files of
`doc/depcensus/` (see `doc/depcensus/README.md`). No library imports this file.

* **Nodes**: every constant whose module belongs to one of the four `lean_lib`s (`HPC`,
  `HPCExtra`, `HPCArchive`, `HPCCensus`).
* **Declaration** of a constant: the declaration a reader sees (`declOf`).
* **Counted declaration**: a theorem, definition, structure, inductive type, instance or
  abbreviation written in a source file (`main`, field `counted`).
* **Edges**: the constants in the type or value of a node (`ConstantInfo.getUsedConstantsAsSet`);
  for an inductive type also its constructors and recursor.
* **Raw closure** of a set of targets: the constants reachable along the edges.
* **Used**: a counted declaration in the raw closure; a structure (or inductive type) one of whose
  constructors or projections is in the raw closure.
-/

open Lean Meta

set_option maxHeartbeats 0

namespace DepCensus

/-- The roots of the four `lean_lib`s of `lakefile.toml`. -/
def libRoots : List Name := [`HPC, `HPCExtra, `HPCArchive, `HPCCensus]

def isLibModule (m : Name) : Bool := libRoots.contains m.getRoot

/-- `HPC.BJ59.Foo` ↦ `HPC/BJ59/Foo.lean`. -/
def moduleFile (m : Name) : System.FilePath :=
  System.FilePath.mk (("/".intercalate (m.components.map toString)) ++ ".lean")

/-- `HPC.BJ59.Foo` ↦ `HPC/BJ59`; a root module ↦ `.`. -/
def moduleDir (m : Name) : String :=
  match m.components.dropLast with
  | [] => "."
  | cs => "/".intercalate (cs.map toString)

/-- The package of an external module: its first component. -/
def packageOf (m : Name) : String := toString m.getRoot

/-- The primary targets. -/
def primaryTargets : List Name :=
  [`HPC.BJ59.ho16_classification_plane₄, `HPC.BJ59.ho16_classification₄]

/-- The comparison targets, each alone. -/
def comparisonTargets : List Name :=
  [`HPC.BJ59.ho16_classification_atomic', `HPC.BJ59.bjThm10, `HPC.BJ59.bjPlaneExample,
   `HPC.Plane.isPseudoArc_plane]

/-- `s` is `pre` followed by one or more digits. -/
def digitsAfter (s pre : String) : Bool :=
  s.startsWith pre && (s.drop pre.length).toString.length > 0 &&
    (s.drop pre.length).toString.all Char.isDigit

/-- Last components generated by the elaborator for the declaration they follow. -/
def isGeneratedSuffix (s : String) : Bool :=
  s.front == '_' || digitsAfter s "proof_" || digitsAfter s "match_" || digitsAfter s "eq_" ||
  s == "eq_def" || s == "eq_unfold" || s == "induct" || s == "mutual_induct" ||
  s == "fun_cases" || s == "induct_unfolding" || digitsAfter s "_simp_"

/-- Last components generated for an inductive type or constructor (only stripped when the
prefix is an inductive type or a constructor). -/
def inductiveSuffixes : List String :=
  ["below", "ibelow", "brecOn", "binductionOn", "recOn", "casesOn", "noConfusion",
   "noConfusionType", "ctorIdx", "toCtorIdx", "ctorElim", "ctorElimType", "inj", "injEq",
   "sizeOf_spec", "elim"]

/-- One step towards the declaration a reader sees; `none` when `n` is already one. -/
def ownerStep (env : Environment) (n : Name) : Option Name :=
  match env.find? n with
  | some (.ctorInfo v) => some v.induct
  | some (.recInfo v) => v.all.head?
  | _ =>
    if let some info := env.getProjectionFnInfo? n then
      match env.find? info.ctorName with
      | some (.ctorInfo v) => some v.induct
      | _ => none
    else if isAuxRecursor env n || isNoConfusion env n || isMatcherCore env n then
      some n.getPrefix
    else
      match n with
      | .num p _ =>
        -- a private prefix `_private.M.0` is not a declaration
        if p.isAnonymous || (p matches .str _ "_private") then none else some p
      | .str p s =>
        if p.isAnonymous then none
        else if isGeneratedSuffix s then some p
        else if inductiveSuffixes.contains s then
          match env.find? p with
          | some (.inductInfo _) | some (.ctorInfo _) => some p
          | _ => none
        else none
      | .anonymous => none

/-- The declaration of a constant: follow `ownerStep` while the result is a constant. -/
partial def declOf (env : Environment) (n : Name) : Name :=
  match ownerStep env n with
  | some p => if p != n && env.contains p then declOf env p else n
  | none => n

/-- Whether a name (after removing a private prefix) has an internal component. -/
def isInternalName (n : Name) : Bool :=
  (privateToUserName? n |>.getD n).isInternal

/-- Types of syntax, parser, macro, elaborator and delaborator constants. -/
def metaTypeNames : List Name :=
  [``Lean.ParserDescr, ``Lean.TrailingParserDescr, ``Lean.Parser.Parser,
   ``Lean.Parser.TrailingParser, ``Lean.Macro, ``Lean.PrettyPrinter.Unexpander,
   ``Lean.Elab.Term.TermElab, ``Lean.Elab.Command.CommandElab, ``Lean.Elab.Tactic.Tactic,
   ``Lean.PrettyPrinter.Delaborator.Delab, ``Lean.SyntaxNodeKind]

def isMetaConst (ci : ConstantInfo) : Bool :=
  match ci.type.getAppFn with
  | .const c _ => metaTypeNames.contains c
  | _ => false

/-- The kind column of `nodes.tsv`. -/
def kindOf (env : Environment) (n : Name) (ci : ConstantInfo) : String :=
  if (env.getProjectionFnInfo? n).isSome then "projection" else
  match ci with
  | .thmInfo _ => "theorem"
  | .defnInfo v =>
    if isMetaConst ci then "syntax"
    else if isInstanceCore env n then "instance"
    else if v.hints matches .abbrev then "abbrev"
    else "def"
  | .opaqueInfo _ => "opaque"
  | .axiomInfo _ => "axiom"
  | .quotInfo _ => "quot"
  | .inductInfo _ =>
    if isClass env n then (if isStructure env n then "class" else "class-inductive")
    else if isStructure env n then "structure" else "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

/-- The edges of a node. -/
def edgesOf (n : Name) (ci : ConstantInfo) : NameSet := Id.run do
  let mut s := ci.getUsedConstantsAsSet
  if let .inductInfo v := ci then
    for c in v.ctors do s := s.insert c
    s := s.insert (Name.str n "rec")
  return s.erase n

structure Node where
  name : Name
  module : Name
  kind : String
  decl : Name
  counted : Bool
  startLine : Nat
  endLine : Nat
  /-- start line extended upwards over the docstring -/
  docStart : Nat
  headline : Bool
  docFirst : String
  edges : Array Name
  deriving Inhabited

def tsvClean (s : String) : String := (s.replace "\t" " ").replace "\n" " "

/-- The first non-empty line of a docstring. -/
def firstLine (doc : String) : String :=
  match (doc.splitOn "\n").map (fun l => l.trimAscii.toString) |>.filter (· ≠ "") with
  | l :: _ => l
  | [] => ""

/-- Extend a declaration's start line upwards over its docstring: if the line above the
declaration (skipping attribute-only and blank lines) closes a comment that a line beginning
with the docstring opener opens, move up to that line. -/
def extendOverDoc (lines : Array String) (start : Nat) (hasDoc : Bool) : Nat := Id.run do
  if !hasDoc || start == 0 then return start
  -- line numbers are 1-based; `lines[i-1]` is line `i`
  let lineAt (i : Nat) : String := (lines[i - 1]?.getD "").trimAscii.toString
  if (lineAt start).startsWith "/--" then return start
  let mut i := start - 1
  while i > 0 && ((lineAt i).startsWith "@[" || lineAt i == "") do
    i := i - 1
  if i == 0 || !((lineAt i).endsWith "-/") then return start
  -- the line that opens the comment closed on line `i`: the first line upwards containing `/-`
  let mut j := i
  while j > 0 && !(((lineAt j).splitOn "/-").length > 1) do
    j := j - 1
  if j == 0 || !((lineAt j).startsWith "/--") then return start else return j

/-- Breadth-first closure from `targets` along `edges` (only nodes have outgoing edges). -/
def closure (edges : Std.HashMap Name (Array Name)) (targets : List Name) : NameSet := Id.run do
  let mut seen : NameSet := {}
  let mut queue : Array Name := #[]
  for t in targets do
    if !seen.contains t then
      seen := seen.insert t
      queue := queue.push t
  let mut i := 0
  while h : i < queue.size do
    let c := queue[i]
    i := i + 1
    for d in edges.getD c #[] do
      if !seen.contains d then
        seen := seen.insert d
        queue := queue.push d
  return seen

/-- The used counted declarations of a raw closure. -/
def usedDecls (nodes : Std.HashMap Name Node) (raw : NameSet) : NameSet := Id.run do
  let mut used : NameSet := {}
  for c in raw do
    if let some nd := nodes[c]? then
      if nd.counted then used := used.insert c
      else if nd.kind == "constructor" || nd.kind == "projection" then
        if let some d := nodes[nd.decl]? then
          if d.counted then used := used.insert d.name
  return used

/-- Number of lines in the union of the ranges `[a, b]`. -/
def unionLength (ranges : Array (Nat × Nat)) : Nat := Id.run do
  let rs := ranges.qsort (fun x y => x.1 < y.1 || (x.1 == y.1 && x.2 < y.2))
  let mut total := 0
  let mut curA := 0
  let mut curB := 0
  let mut started := false
  for (a, b) in rs do
    if !started then
      curA := a; curB := b; started := true
    else if a ≤ curB + 1 then
      curB := max curB b
    else
      total := total + (curB - curA + 1)
      curA := a; curB := b
  if started then total := total + (curB - curA + 1)
  return total

def boolStr (b : Bool) : String := if b then "1" else "0"

def nameLt (a b : Name) : Bool := Name.lt a b

def main : MetaM Unit := do
  let env ← getEnv
  let outDir : System.FilePath := "doc/depcensus"
  IO.FS.createDirAll outDir
  let modNames := env.header.moduleNames
  let libMods : Array Name := modNames.filter isLibModule
  let libModSet : NameSet := libMods.foldl (·.insert ·) {}
  -- source lines of every module file
  let mut fileLines : Std.HashMap Name (Array String) := {}
  for m in libMods do
    let ls ← IO.FS.lines (moduleFile m)
    fileLines := fileLines.insert m ls
  -- nodes
  let mut nodes : Std.HashMap Name Node := {}
  let mut edgeMap : Std.HashMap Name (Array Name) := {}
  let mut order : Array Name := #[]
  for (n, ci) in env.constants.map₁.toList do
    let some idx := env.getModuleIdxFor? n | continue
    let m := modNames[idx.toNat]!
    if !libModSet.contains m then continue
    let decl := declOf env n
    let kind := kindOf env n ci
    let ranges? ← findDeclarationRanges? n
    let doc? ← findDocString? env n
    let countedKind := ["theorem", "def", "abbrev", "instance", "opaque", "structure",
      "inductive", "class", "class-inductive"].contains kind
    let counted := countedKind && decl == n && ranges?.isSome && !isInternalName n
    let (s, e) := match ranges? with
      | some r => (r.range.pos.line, r.range.endPos.line)
      | none => (0, 0)
    let lines := fileLines.getD m #[]
    let ds := extendOverDoc lines s doc?.isSome
    let docFirst := (doc?.map firstLine).getD ""
    let headline := counted && ((doc?.getD "").trimAsciiStart.toString.startsWith "**")
    let es := (edgesOf n ci).toArray
    nodes := nodes.insert n
      { name := n, module := m, kind, decl, counted, startLine := s, endLine := e,
        docStart := ds, headline, docFirst := tsvClean docFirst, edges := es }
    edgeMap := edgeMap.insert n es
    order := order.push n
  order := order.qsort nameLt
  IO.println s!"nodes: {nodes.size}, counted: {(order.filter (fun n => (nodes[n]!).counted)).size}"
  -- nodes.tsv
  do
    let mut out1 := "name\tuser_name\tmodule\tkind\tdeclaration\tcounted\tstart\tend\tdoc_start\theadline\n"
    for n in order do
      let nd := nodes[n]!
      out1 := out1 ++ s!"{n}\t{privateToUserName n}\t{nd.module}\t{nd.kind}\t{nd.decl}\t{boolStr nd.counted}\t{nd.startLine}\t{nd.endLine}\t{nd.docStart}\t{boolStr nd.headline}\n"
    IO.FS.writeFile (outDir / "nodes.tsv") out1
  -- edges.tsv and edges-external.tsv
  do
    let mut outI := "source\ttarget\n"
    let mut outE := "source\ttarget\tpackage\tmodule\n"
    for n in order do
      let nd := nodes[n]!
      for t in nd.edges.qsort nameLt do
        if nodes.contains t then
          outI := outI ++ s!"{n}\t{t}\n"
        else
          let tm := (env.getModuleIdxFor? t).map (fun i => modNames[i.toNat]!)
          let tmS := (tm.map toString).getD "?"
          let pkg := (tm.map packageOf).getD "?"
          outE := outE ++ s!"{n}\t{t}\t{pkg}\t{tmS}\n"
    IO.FS.writeFile (outDir / "edges.tsv") outI
    IO.FS.writeFile (outDir / "edges-external.tsv") outE
  -- the primary closure
  let raw := closure edgeMap primaryTargets
  let used := usedDecls nodes raw
  let usedArr := used.toArray.qsort nameLt
  do
    let mut out3 := ""
    for n in usedArr do
      out3 := out3 ++ s!"{n}\t{(nodes[n]!).module}\n"
    IO.FS.writeFile (outDir / "used.txt") out3
  -- the raw closure, for the record
  do
    let mut out4 := ""
    for n in raw.toArray.qsort nameLt do
      let where_ := if nodes.contains n then "node" else
        ((env.getModuleIdxFor? n).map (fun i => toString modNames[i.toNat]!)).getD "?"
      out4 := out4 ++ s!"{n}\t{where_}\n"
    IO.FS.writeFile (outDir / "closure.tsv") out4
  -- per-module statistics: module ↦ (counted, used, source lines, covered lines)
  let moduleStats (usedSet : NameSet) : Std.HashMap Name (Nat × Nat × Nat × Nat) := Id.run do
    let mut cnt : Std.HashMap Name Nat := {}
    let mut ucnt : Std.HashMap Name Nat := {}
    let mut rngs : Std.HashMap Name (Array (Nat × Nat)) := {}
    for n in order do
      let nd := nodes[n]!
      if nd.counted then
        cnt := cnt.insert nd.module (cnt.getD nd.module 0 + 1)
        if usedSet.contains n then
          ucnt := ucnt.insert nd.module (ucnt.getD nd.module 0 + 1)
          rngs := rngs.insert nd.module ((rngs.getD nd.module #[]).push (nd.docStart, nd.endLine))
    let mut res : Std.HashMap Name (Nat × Nat × Nat × Nat) := {}
    for m in libMods do
      res := res.insert m (cnt.getD m 0, ucnt.getD m 0, (fileLines.getD m #[]).size,
        unionLength (rngs.getD m #[]))
    return res
  let stats := moduleStats used
  let libModsSorted := libMods.qsort nameLt
  do
    let mut out5 := "module\tdirectory\tdeclarations\tused\tlines\tused_lines\n"
    for m in libModsSorted do
      let (c, u, l, ul) := stats[m]!
      out5 := out5 ++ s!"{m}\t{moduleDir m}\t{c}\t{u}\t{l}\t{ul}\n"
    IO.FS.writeFile (outDir / "modules.tsv") out5
  -- unused modules and import-only modules
  let unusedMods := libModsSorted.filter (fun m => (stats[m]!).2.1 == 0)
  let usedMods := libModsSorted.filter (fun m => (stats[m]!).2.1 > 0)
  IO.FS.writeFile (outDir / "unused-modules.txt")
    (String.join (unusedMods.toList.map (fun m => s!"{m}\n")))
  let modIdx : Std.HashMap Name Nat := Id.run do
    let mut r := {}
    for i in [0:modNames.size] do r := r.insert modNames[i]! i
    return r
  let importClosure : NameSet := Id.run do
    let mut seen : NameSet := {}
    let mut stack : Array Name := usedMods
    while stack.size > 0 do
      let m := stack.back!
      stack := stack.pop
      let some i := modIdx[m]? | continue
      for imp in env.header.moduleData[i]!.imports do
        if isLibModule imp.module && !seen.contains imp.module then
          seen := seen.insert imp.module
          stack := stack.push imp.module
    return seen
  let importOnly := unusedMods.filter importClosure.contains
  IO.FS.writeFile (outDir / "import-only.txt")
    (String.join (importOnly.toList.map (fun m => s!"{m}\n")))
  -- headlines
  do
    let mut out6 := "name\tmodule\tused\tdocstring_first_line\n"
    for n in order do
      let nd := nodes[n]!
      if nd.headline then
        out6 := out6 ++ s!"{privateToUserName n}\t{nd.module}\t{boolStr (used.contains n)}\t{nd.docFirst}\n"
    IO.FS.writeFile (outDir / "headlines.tsv") out6
  -- the spine: used headlines in a dependency order (postorder of a depth-first search)
  let usedHeadlines : NameSet := used.foldl (fun s n =>
    if (nodes[n]!).headline then s.insert n else s) {}
  let postorder : Array Name := Id.run do
    let mut visited : NameSet := {}
    let mut out : Array Name := #[]
    let mut stack : Array (Name × Bool) := (primaryTargets.reverse.map (·, false)).toArray
    while stack.size > 0 do
      let (c, expanded) := stack.back!
      stack := stack.pop
      if expanded then
        out := out.push c
      else if !visited.contains c then
        visited := visited.insert c
        stack := stack.push (c, true)
        let es := (edgeMap.getD c #[]).qsort (fun a b => Name.lt b a)
        for d in es do
          if !visited.contains d then stack := stack.push (d, false)
    return out
  let spine := postorder.filter usedHeadlines.contains
  -- dependents: number of used headlines whose closure contains a given headline
  let mut dependents : Std.HashMap Name Nat := {}
  let mut dependsOn : Std.HashMap Name Nat := {}
  for h in spine do
    let cl := closure edgeMap [h]
    let mut k := 0
    for b in spine do
      if b != h && cl.contains b then
        dependents := dependents.insert b (dependents.getD b 0 + 1)
        k := k + 1
    dependsOn := dependsOn.insert h k
  do
    let mut out7 := "rank\tname\tmodule\tdirectory\tdependents\tdepends_on\tdocstring_first_line\n"
    let mut r := 0
    for h in spine do
      r := r + 1
      let nd := nodes[h]!
      out7 := out7 ++ s!"{r}\t{privateToUserName h}\t{nd.module}\t{moduleDir nd.module}\t{dependents.getD h 0}\t{dependsOn.getD h 0}\t{nd.docFirst}\n"
    IO.FS.writeFile (outDir / "spine.tsv") out7
  -- external constants of the primary closure
  let mut extUsers : Std.HashMap Name Nat := {}
  for c in raw do
    if let some nd := nodes[c]? then
      for t in nd.edges do
        if !nodes.contains t then
          extUsers := extUsers.insert t (extUsers.getD t 0 + 1)
  let extArr := extUsers.toArray.qsort (fun a b => Name.lt a.1 b.1)
  let extModOf (t : Name) : Name :=
    ((env.getModuleIdxFor? t).map (fun i => modNames[i.toNat]!)).getD `«?»
  do
    let mut out8 := "constant\tpackage\tmodule\tused_by\n"
    for (t, k) in extArr do
      let m := extModOf t
      out8 := out8 ++ s!"{t}\t{packageOf m}\t{m}\t{k}\n"
    IO.FS.writeFile (outDir / "external.tsv") out8
  do
    let mut perMod : Std.HashMap Name (Nat × Nat) := {}
    for (t, k) in extArr do
      let m := extModOf t
      let (a, b) := perMod.getD m (0, 0)
      perMod := perMod.insert m (a + 1, b + k)
    let rows := perMod.toArray.qsort (fun a b =>
      packageOf a.1 < packageOf b.1 || (packageOf a.1 == packageOf b.1 && Name.lt a.1 b.1))
    let mut out9 := "package\tmodule\tconstants\tuses\n"
    for (m, (a, b)) in rows do
      out9 := out9 ++ s!"{packageOf m}\t{m}\t{a}\t{b}\n"
    IO.FS.writeFile (outDir / "external-modules.tsv") out9
  -- summary: primary and comparison targets
  let totalDecls := (order.filter (fun n => (nodes[n]!).counted)).size
  let totalLines := libMods.foldl (fun s m => s + (fileLines.getD m #[]).size) 0
  let summaryRow (label : String) (targets : List Name) : String := Id.run do
    let raw' := closure edgeMap targets
    let used' := usedDecls nodes raw'
    let st := moduleStats used'
    let mods := libMods.filter (fun m => (st[m]!).2.1 > 0)
    let lines := libMods.foldl (fun s m => s + (st[m]!).2.2.2) 0
    let modLines := mods.foldl (fun s m => s + (st[m]!).2.2.1) 0
    s!"{label}\t{raw'.size}\t{used'.size}\t{totalDecls}\t{mods.size}\t{libMods.size}\t{lines}\t{modLines}\t{totalLines}\n"
  do
    let mut out10 := "target\traw_closure\tused_declarations\tlibrary_declarations\tmodules_used\tlibrary_modules\tused_lines\tlines_of_modules_used\tlibrary_lines\n"
    out10 := out10 ++ summaryRow "primary" primaryTargets
    for t in comparisonTargets do
      out10 := out10 ++ summaryRow (toString t) [t]
    IO.FS.writeFile (outDir / "summary.tsv") out10
  -- by directory (primary)
  do
    let mut dirs : Std.HashMap String (Nat × Nat × Nat × Nat × Nat × Nat) := {}
    for m in libMods do
      let (c, u, l, ul) := stats[m]!
      let d := moduleDir m
      let (a, b, x, y, mm, mu) := dirs.getD d (0, 0, 0, 0, 0, 0)
      dirs := dirs.insert d (a + c, b + u, x + l, y + ul, mm + 1, mu + (if u > 0 then 1 else 0))
    let rows := dirs.toArray.qsort (fun a b => a.1 < b.1)
    let mut out11 := "directory\tmodules\tmodules_used\tdeclarations\tused\tlines\tused_lines\n"
    for (d, (a, b, x, y, mm, mu)) in rows do
      out11 := out11 ++ s!"{d}\t{mm}\t{mu}\t{a}\t{b}\t{x}\t{y}\n"
    IO.FS.writeFile (outDir / "directories.tsv") out11
  -- sanity checks
  do
    let mut out12 := ""
    let must : List Name := [`HPC.BJ59.bjThm10, `HPC.BJ59.bjPlaneExample,
      `HPC.BJ59.CircDescr.isCircleOfPA, `HPC.BJ59.ho16_classification, `HPC.BJ59.hoCircleLike,
      `HPC.HO16.ho16_theorem20, `HPC.HO16.ho16_indec_homogeneous_iff, `HPC.Plane.isPseudoArc_plane]
    for n in must do
      out12 := out12 ++ s!"in_closure\t{n}\t{raw.contains n}\tused\t{used.contains n}\n"
    let archive := raw.toArray.filter (fun c => match nodes[c]? with
      | some nd => (`HPC.Archive).isPrefixOf nd.module || (`HPC.Census).isPrefixOf nd.module
          || nd.module == `HPCArchive || nd.module == `HPCCensus
      | none => false)
    out12 := out12 ++ s!"archive_or_census_constants_in_closure\t{archive.size}\n"
    for c in archive do out12 := out12 ++ s!"archive_or_census\t{c}\n"
    for n in usedArr do
      let last := match privateToUserName n with
        | .str _ s => s
        | _ => ""
      if last.startsWith "nonvac" || last.endsWith "_false" || last.endsWith "_counterexample" then
        let nd := nodes[n]!
        let some ci := env.find? n | continue
        let ty ← ppExpr ci.type
        out12 := out12 ++ s!"flagged\t{privateToUserName n}\t{nd.module}\t{nd.kind}\t{tsvClean (toString ty)}\n"
    IO.FS.writeFile (outDir / "sanity.tsv") out12
    IO.println out12
  IO.println s!"raw closure: {raw.size}; used declarations: {used.size}; modules used: {usedMods.size} of {libMods.size}"

end DepCensus

#eval DepCensus.main
