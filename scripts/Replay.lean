import Lean

/-!
# Kernel replay of the primary closure (batch 203)

Run from the repository root, after `lake build HPC HPCExtra HPCArchive HPCCensus` and
`lake env lean scripts/DepCensus.lean`:

```
lake env lean scripts/Replay.lean
```

1. Read the constants of every module of the four libraries from their `.olean` files
   (the modules listed in `doc/depcensus/modules.tsv`); no library module is imported.
2. Compute the raw closure of the two primary targets along the edges of `DepCensus.lean`
   (the constants in the type or value; for an inductive type also its constructors and recursor).
   This is a third computation of the closure, compared with `doc/depcensus/closure.tsv`.
3. Build an environment that imports only the external modules of
   `doc/depcensus/external-modules.tsv` (no `HPC` module).
4. Check that every closure constant outside the libraries is present in that environment, and
   replay the closure constants of the libraries into it with `Lean.Environment.replay`, which sends
   every definition, theorem and inductive type to the kernel (constructors and recursors are
   regenerated by the kernel and compared with the stored ones).
5. Check that the two targets are present in the result, with the stored types, and elaborate the
   statements of `HPC/BJ59/BJ59E.lean` (copied verbatim from the file) in the replayed
   environment, comparing the elaborated types with the replayed constants' types.

The results are written to `doc/depcensus/replay.txt`.
-/

open Lean

set_option maxHeartbeats 0

namespace DepReplay

def primaryTargets : List Name :=
  [`HPC.BJ59.ho16_classification_plane₄, `HPC.BJ59.ho16_classification₄]

/-- The edges of `DepCensus.lean`. -/
def edgesOf (n : Name) (ci : ConstantInfo) : NameSet := Id.run do
  let mut s := ci.getUsedConstantsAsSet
  if let .inductInfo v := ci then
    for c in v.ctors do s := s.insert c
    s := s.insert (Name.str n "rec")
  return s.erase n

/-- First column of a TSV file, skipping the header. -/
def column (path : System.FilePath) (col : Nat) : IO (Array String) := do
  let ls ← IO.FS.lines path
  return (ls.extract 1 ls.size).filterMap fun l =>
    if l.trimAscii.isEmpty then none else (l.splitOn "\t")[col]?

/-- The text of a theorem's statement in a source file: from `theorem <name>` to the `:=` that
ends the statement (the first line ending with `:=`). -/
def statementText (src : String) (name : String) : Option String := Id.run do
  let lines := src.splitOn "\n"
  let mut out : Array String := #[]
  let mut inside := false
  for l in lines do
    if !inside && l.startsWith s!"theorem {name} " then inside := true
    if inside then
      out := out.push l
      if l.trimAsciiEnd.toString.endsWith ":=" then
        return some ("\n".intercalate out.toList)
  return none

def main : IO Unit := do
  let mut report : Array String := #[]
  let say (r : Array String) (s : String) : IO (Array String) := do
    IO.println s
    return r.push s
  -- 1. the library constants, from the .olean files
  let libMods := (← column "doc/depcensus/modules.tsv" 0).map String.toName
  let mut lib : Std.HashMap Name ConstantInfo := {}
  for m in libMods do
    let olean ← findOLean m
    let (md, _region) ← readModuleData olean
    for ci in md.constants do
      lib := lib.insert ci.name ci
  report ← say report s!"library modules read: {libMods.size}; library constants: {lib.size}"
  -- 2. the closure
  let mut seen : NameSet := {}
  let mut queue : Array Name := #[]
  for t in primaryTargets do
    seen := seen.insert t
    queue := queue.push t
  let mut i := 0
  while h : i < queue.size do
    let c := queue[i]
    i := i + 1
    if let some ci := lib[c]? then
      for d in edgesOf c ci do
        if !seen.contains d then
          seen := seen.insert d
          queue := queue.push d
  let closureLib := queue.filter lib.contains
  let closureExt := queue.filter (fun c => !lib.contains c)
  report ← say report s!"raw closure: {queue.size} constants ({closureLib.size} of the libraries, {closureExt.size} external)"
  -- compare with the census
  let census := (← IO.FS.lines "doc/depcensus/closure.tsv").filterMap fun l =>
    (l.splitOn "\t")[0]?
  let censusSet : Std.HashSet String := census.foldl (·.insert ·) {}
  let mineSet : Std.HashSet String := queue.foldl (fun s n => s.insert (toString n)) {}
  let onlyCensus := census.filter (fun s => !mineSet.contains s)
  let onlyMine := queue.filter (fun n => !censusSet.contains (toString n))
  report ← say report s!"agreement with doc/depcensus/closure.tsv: {onlyCensus.size == 0 && onlyMine.size == 0} (census {census.size}, here {queue.size}, only in census {onlyCensus.size}, only here {onlyMine.size})"
  -- 3. the external environment
  let extMods := (← column "doc/depcensus/external-modules.tsv" 1).map String.toName
  report ← say report s!"external modules imported: {extMods.size}"
  let env ← importModules (extMods.map fun m => { module := m }) {} (trustLevel := 0)
    (loadExts := true)
  report ← say report s!"constants in the external environment: {env.constants.map₁.size}"
  -- 4. completeness and replay
  let missing := closureExt.filter (fun c => !env.contains c)
  report ← say report s!"external closure constants missing from the external environment: {missing.size}"
  for c in missing do report ← say report s!"  missing: {c}"
  let clashing := closureLib.filter env.contains
  report ← say report s!"library closure constants already present in the external environment: {clashing.size}"
  let mut newConsts : Std.HashMap Name ConstantInfo := {}
  let mut skipped := 0
  for c in closureLib do
    let ci := lib[c]!
    if ci.isUnsafe || ci.isPartial then skipped := skipped + 1
    newConsts := newConsts.insert c ci
  report ← say report s!"constants sent to replay: {newConsts.size} (unsafe or partial, skipped by replay: {skipped})"
  let t0 ← IO.monoMsNow
  let env' ← env.replay newConsts
  let t1 ← IO.monoMsNow
  report ← say report s!"replay: every constant accepted by the kernel ({(t1 - t0) / 1000} s)"
  let absent := closureLib.filter (fun c => !env'.contains c)
  report ← say report s!"library closure constants absent after replay: {absent.size}"
  -- 5. the targets
  let src ← IO.FS.readFile "HPC/BJ59/BJ59E.lean"
  -- `replay` adds constants through the kernel only, so the namespaces of the libraries are not
  -- registered; `namespace X end X` registers them before they are opened.
  -- Likewise `abbrev` is an elaborator notion (the attribute `[reducible]`): the kernel records only
  -- the hint. The check input restores the attribute for the closure's abbreviations (such as `Pt`).
  let mut checkInput := "namespace HPC.Plane end HPC.Plane\nnamespace HPC.Jones end HPC.Jones\n" ++
    "namespace HPC.HO16 end HPC.HO16\n"
  -- the abbreviations written in the sources: kind `abbrev`, counted, in `nodes.tsv`
  let closureNames : Std.HashSet String := closureLib.foldl (fun s n => s.insert (toString n)) {}
  let mut nAbbrev := 0
  for l in ← IO.FS.lines "doc/depcensus/nodes.tsv" do
    let cols := l.splitOn "\t"
    if cols[3]? == some "abbrev" && cols[5]? == some "1" then
      let some c := cols[0]? | continue
      if closureNames.contains c && !c.startsWith "_private" then
        checkInput := checkInput ++ s!"attribute [reducible] {c}\n"
        nAbbrev := nAbbrev + 1
  report ← say report s!"abbreviations of the closure given back the attribute [reducible]: {nAbbrev}"
  checkInput := checkInput ++ "namespace HPC.BJ59\nopen Set Topology Metric Filter HPC.Plane HPC.Jones HPC.HO16\n"
  for t in primaryTargets do
    let some ci := env'.find? t | report ← say report s!"target {t}: ABSENT after replay"; continue
    let same := ci.type == lib[t]!.type
    report ← say report s!"target {t}: present after replay, kind {if ci matches .thmInfo _ then "theorem" else "other"}, type identical to the stored type: {same}"
    let short := toString (t.componentsRev.head!)
    match statementText src short with
    | some st =>
      checkInput := checkInput ++ (st.replace s!"theorem {short} " s!"theorem {short}_stmt ") ++ " sorry\n"
    | none => report ← say report s!"  statement of {short} not found in HPC/BJ59/BJ59E.lean"
  checkInput := checkInput ++ "end HPC.BJ59\n"
  report ← say report "statements elaborated in the replayed environment (copied from HPC/BJ59/BJ59E.lean):"
  for l in checkInput.splitOn "\n" do report ← say report s!"    {l}"
  let (env'', msgs) ← Elab.process checkInput env' {} (fileName := "<replay-check>")
  for m in msgs.toList do
    let s ← m.toString
    report ← say report s!"  message: {s.trimAscii}"
  for t in primaryTargets do
    let chk := Name.str t.getPrefix (toString t.componentsRev.head! ++ "_stmt")
    match env''.find? chk, env'.find? t with
    | some c1, some c2 =>
      report ← say report s!"target {t}: the elaborated source statement is identical to the replayed type: {c1.type == c2.type}"
    | _, _ => report ← say report s!"target {t}: source statement did not elaborate"
  IO.FS.writeFile "doc/depcensus/replay.txt" ("\n".intercalate report.toList ++ "\n")

end DepReplay

#eval DepReplay.main
