import Mathlib

/-!
# Batch 137 skeleton: Moore, *On the foundations of plane analysis situs*, Trans. AMS 17 (1916),
# §§2–5 (Theorems 1–19), the bridge to topology, and the arc characterization

Save as `HPC/Moore/FA.lean` (new directory; splitting into several files under `HPC/Moore/` is
expected); add `import HPC.Moore.FA` at the end of `HPC.lean`. Every `sorry` is a work item.
Shapes may be adjusted, each change recorded at the statement and in the report.

Transcribed from page images at 200 dpi (pp. 131–140). Moore's primitives are kept: a type `S` of
*points* and a class of subsets called *regions*. Every other notion (limit point, boundary,
connected, closed, bounded, Heine–Borel, arc) is defined from regions exactly as on pp. 132–139.
§3 of this file then connects them with the topology generated by the regions.

Notation. Moore writes `M'` for `M` plus its boundary (`cl`), `M + N` for union, `M − N` for
difference, "region about `P`" for "region containing `P`", and "without `R`" for "in the
exterior of `R`".
-/

namespace HPC.Moore

open Set

/-! ## §1. Primitives and definitions (F.A. §2, p. 132) -/

/-- A *space* in Moore's sense: points (the type `S`) and a class of subsets called regions. -/
structure Space (S : Type*) where
  region : Set (Set S)

variable {S : Type*} (σ : Space S)

namespace Space

/-- `P` is a *limit point* of `M`: every region containing `P` contains a point of `M` other than
`P`. -/
def IsLimitPt (P : S) (M : Set S) : Prop :=
  ∀ R ∈ σ.region, P ∈ R → ∃ x ∈ M, x ∈ R ∧ x ≠ P

/-- The *boundary* of `M`: the points `X` such that every region containing `X` contains a point
of `M` and a point not in `M`. -/
def bdry (M : Set S) : Set S :=
  {X | ∀ R ∈ σ.region, X ∈ R → (R ∩ M).Nonempty ∧ (R \ M).Nonempty}

/-- `M'`: `M` together with its boundary. -/
def cl (M : Set S) : Set S := M ∪ σ.bdry M

/-- The *exterior* of `M` is `S − M'` (Moore defines it for a region). -/
def ext (M : Set S) : Set S := (σ.cl M)ᶜ

/-- *Connected*: however `M` is divided into two mutually exclusive subsets, one of them contains
a limit point of the other.
**Implicit hypothesis (to record):** the two parts must be nonempty. Otherwise the split
`M = M ∪ ∅` would make every set disconnected. -/
def IsConn (M : Set S) : Prop :=
  ∀ A B : Set S, A ∪ B = M → Disjoint A B → A.Nonempty → B.Nonempty →
    (∃ x ∈ A, σ.IsLimitPt x B) ∨ (∃ x ∈ B, σ.IsLimitPt x A)

/-- A set of regions `K` *covers* `M`. -/
def Covers (K : Set (Set S)) (M : Set S) : Prop := K ⊆ σ.region ∧ M ⊆ ⋃₀ K

/-- The *Heine–Borel property*. Moore says "for every infinite set of regions covering `M`";
finite covers are trivially their own finite subcovers. -/
def HeineBorel (M : Set S) : Prop :=
  ∀ K : Set (Set S), σ.Covers K M → ∃ F : Finset (Set S), ↑F ⊆ K ∧ M ⊆ ⋃₀ ↑F

/-- *Closed* (p. 135): contains all its limit points. -/
def IsClosedM (M : Set S) : Prop := ∀ P, σ.IsLimitPt P M → P ∈ M

/-- *Bounded* (p. 135): contained in `(R₁ + ⋯ + Rₙ)'` for finitely many regions. -/
def IsBoundedM (M : Set S) : Prop :=
  ∃ F : Finset (Set S), ↑F ⊆ σ.region ∧ M ⊆ σ.cl (⋃₀ ↑F)

/-- *Domain* (p. 136): a connected set each point of which lies in a region inside the set. -/
def IsDomain (M : Set S) : Prop :=
  σ.IsConn M ∧ ∀ P ∈ M, ∃ R ∈ σ.region, P ∈ R ∧ R ⊆ M

/-- *Simple continuous arc from `A` to `B`* (p. 136, after Lennes 1911, p. 308): a bounded,
closed, connected set containing `A` and `B` and containing no connected proper subset that
contains both. -/
def IsArc (A B : S) (C : Set S) : Prop :=
  A ≠ B ∧ σ.IsBoundedM C ∧ σ.IsClosedM C ∧ σ.IsConn C ∧ A ∈ C ∧ B ∈ C ∧
    ∀ H ⊆ C, H ≠ C → A ∈ H → B ∈ H → ¬ σ.IsConn H

/-- *Simple closed curve* (p. 139, after Lennes p. 314): the union of two arcs from `A` to `B`
with only `A` and `B` in common. -/
def IsSCC (J : Set S) : Prop :=
  ∃ A B : S, ∃ C₁ C₂ : Set S, σ.IsArc A B C₁ ∧ σ.IsArc A B C₂ ∧ C₁ ∩ C₂ = {A, B} ∧
    J = C₁ ∪ C₂

/-- *Sequential limit point* (p. 134). -/
def IsSeqLimit (P : S) (u : ℕ → S) : Prop :=
  ∀ R ∈ σ.region, P ∈ R → ∃ δ : ℕ, ∀ n > δ, u n ∈ R

/-- *Simple chain from `A` to `B`* (p. 134): regions `R₀ … R_{n-1}` (0-indexed here) with `A` only
in the first, `B` only in the last, and `Rᵢ ∩ Rⱼ ≠ ∅` (`i < j`) iff `j = i + 1`. -/
def IsSimpleChain (A B : S) (R : List (Set S)) : Prop :=
  A ≠ B ∧ R ≠ [] ∧ (∀ X ∈ R, X ∈ σ.region) ∧
    (∀ i (h : i < R.length), A ∈ R.get ⟨i, h⟩ ↔ i = 0) ∧
    (∀ i (h : i < R.length), B ∈ R.get ⟨i, h⟩ ↔ i + 1 = R.length) ∧
    (∀ i j (hi : i < R.length) (hj : j < R.length), i < j →
      ((R.get ⟨i, hi⟩ ∩ R.get ⟨j, hj⟩).Nonempty ↔ j = i + 1))

/-! ### The axioms (pp. 132–133). Transcribed from the page image; the overbars matter:
`P̄`, `R̄`, `K̄`, `L̄` are second objects, not closures. -/

/-- **Axiom 1.** There is a sequence of regions `K₁, K₂, …` such that (1) every point lies in `Kₙ`
for arbitrarily large `n`; (2) if `P` and `P̄` are distinct points of a region `R`, then for all
large `n`, `Kₙ ∋ P` implies `Kₙ' ⊆ R − P̄`. -/
def Axiom1 : Prop :=
  ∃ K : ℕ → Set S, (∀ n, K n ∈ σ.region) ∧ (∀ (m : ℕ) (P : S), ∃ n > m, P ∈ K n) ∧
    ∀ R ∈ σ.region, ∀ P ∈ R, ∀ P' ∈ R, P ≠ P' →
      ∃ δ : ℕ, ∀ n > δ, P ∈ K n → σ.cl (K n) ⊆ R \ {P'}

/-- **Axiom 2.** Every region is connected. -/
def Axiom2 : Prop := ∀ R ∈ σ.region, σ.IsConn R

/-- **Axiom 3.** If `R` is a region, `S − R'` is connected. -/
def Axiom3 : Prop := ∀ R ∈ σ.region, σ.IsConn (σ.ext R)

/-- **Axiom 4.** If `R` is a region, `R'` has the Heine–Borel property. -/
def Axiom4 : Prop := ∀ R ∈ σ.region, σ.HeineBorel (σ.cl R)

/-- **Axiom 5.** There is an infinite set of points with no limit point. -/
def Axiom5 : Prop := ∃ M : Set S, M.Infinite ∧ ∀ P, ¬ σ.IsLimitPt P M

/-- **Axiom 5₁** (footnote p. 133): there exist at least three points. -/
def Axiom5₁ : Prop := ∃ a b c : S, a ≠ b ∧ b ≠ c ∧ a ≠ c

/-- **Axiom 6.** If `R`, `R̄` are regions and `P ∈ R̄` is on the boundary of `R`, then there are
regions `K`, `K̄` in `R̄` with `P ∈ K̄`, `K ⊆ R`, and every boundary point of `R` in `K̄` a boundary
point of `K`. -/
def Axiom6 : Prop :=
  ∀ R ∈ σ.region, ∀ R' ∈ σ.region, ∀ P ∈ R', P ∈ σ.bdry R →
    ∃ K ∈ σ.region, ∃ K' ∈ σ.region, K ⊆ R' ∧ K' ⊆ R' ∧ P ∈ K' ∧ K ⊆ R ∧
      σ.bdry R ∩ K' ⊆ σ.bdry K

/-- **Axiom 7.** As Axiom 6, with `L ⊆ S − R'` in place of `K ⊆ R`. -/
def Axiom7 : Prop :=
  ∀ R ∈ σ.region, ∀ R' ∈ σ.region, ∀ P ∈ R', P ∈ σ.bdry R →
    ∃ L ∈ σ.region, ∃ L' ∈ σ.region, L ⊆ R' ∧ L' ⊆ R' ∧ P ∈ L' ∧ L ⊆ σ.ext R ∧
      σ.bdry R ∩ L' ⊆ σ.bdry L

/-- **Axiom 8.** Every simple closed curve is the boundary of at least one region. -/
def Axiom8 : Prop := ∀ J, σ.IsSCC J → ∃ R ∈ σ.region, σ.bdry R = J

end Space

/-! ## §2. F.A. §3: consequences of Axioms 1–3, 5₁ (pp. 133–135)

Hypotheses are those of the section heading. Record for each theorem which axioms are actually
used. -/

section Sec3

variable {σ : Space S} (h1 : σ.Axiom1) (h2 : σ.Axiom2) (h3 : σ.Axiom3) (h51 : σ.Axiom5₁)
include h1 h2 h3 h51

/-- **Theorem 1.** No point of a region is a boundary point of that region. (No proof printed.) -/
theorem fa_theorem1 {R : Set S} (hR : R ∈ σ.region) {P : S} (hP : P ∈ R) :
    P ∉ σ.bdry R := by
  sorry

/-- **Theorem 2.** If `P` is a limit point of `M`, every region containing `P` contains infinitely
many points of `M`. -/
theorem fa_theorem2 {P : S} {M : Set S} (hP : σ.IsLimitPt P M) {R : Set S} (hR : R ∈ σ.region)
    (hPR : P ∈ R) : (R ∩ M).Infinite := by
  sorry

/-- **Theorem 3.** If `M` is finite and `P ∉ M`, some region contains `P` and no point of `M`.
(No proof printed.) -/
theorem fa_theorem3 {P : S} {M : Set S} (hM : M.Finite) (hPM : P ∉ M) :
    ∃ R ∈ σ.region, P ∈ R ∧ Disjoint R M := by
  sorry

/-- **Theorem 4.** Every region contains infinitely many points. -/
theorem fa_theorem4 {R : Set S} (hR : R ∈ σ.region) : R.Infinite := by
  sorry

/-- **Theorem 5.** For each point `P`, a strictly decreasing sequence of regions with
intersection `{P}` that closes down on `P`: every region about `P` contains some `Rₙ'`. -/
theorem fa_theorem5 (P : S) :
    ∃ R : ℕ → Set S, (∀ n, R n ∈ σ.region) ∧ (⋂ n, R n) = {P} ∧ (∀ n, R (n + 1) ⊂ R n) ∧
      ∀ U ∈ σ.region, P ∈ U → ∃ n, σ.cl (R n) ⊆ U := by
  sorry

/-- **Theorem 6.** Two regions with a common point `P` contain a common region about `P`. -/
theorem fa_theorem6 {K L : Set S} (hK : K ∈ σ.region) (hL : L ∈ σ.region) {P : S}
    (hPK : P ∈ K) (hPL : P ∈ L) : ∃ R ∈ σ.region, P ∈ R ∧ R ⊆ K ∩ L := by
  sorry

/-- **Theorem 7.** A limit point of `M + N` is a limit point of `M` or of `N`. (No proof
printed.) -/
theorem fa_theorem7 {P : S} {M N : Set S} (h : σ.IsLimitPt P (M ∪ N)) :
    σ.IsLimitPt P M ∨ σ.IsLimitPt P N := by
  sorry

/-- **Theorem 8.** If `P` is the sequential limit point of `P₁, P₂, …`, no other point is a limit
point of `{P₁, P₂, …}`. -/
theorem fa_theorem8 {P : S} {u : ℕ → S} (hu : σ.IsSeqLimit P u) {X : S} (hX : X ≠ P) :
    ¬ σ.IsLimitPt X (range u) := by
  sorry

/-- **Theorem 9.** A limit point of `M` is the sequential limit point of a sequence of points of
`M` distinct from it. -/
theorem fa_theorem9 {P : S} {M : Set S} (hP : σ.IsLimitPt P M) :
    ∃ u : ℕ → S, (∀ n, u n ∈ M ∧ u n ≠ P) ∧ σ.IsSeqLimit P u := by
  sorry

/-- **Theorem 10.** If `M` is connected, `A ≠ B` are in `M`, and `G` is a set of regions covering
`M`, there is a simple chain from `A` to `B` with every link in `G`. -/
theorem fa_theorem10 {M : Set S} (hM : σ.IsConn M) {A B : S} (hA : A ∈ M) (hB : B ∈ M)
    (hAB : A ≠ B) {G : Set (Set S)} (hG : σ.Covers G M) :
    ∃ R : List (Set S), σ.IsSimpleChain A B R ∧ ∀ X ∈ R, X ∈ G := by
  sorry

/-- Unnumbered (p. 135): "It is clear that if `M` is a set of points then `M'` is closed." -/
theorem fa_cl_isClosed (M : Set S) : σ.IsClosedM (σ.cl M) := by
  sorry

end Sec3

/-! ## §3. F.A. §4: consequences of Axioms 1–4, 5 (pp. 135–139) -/

section Sec4

variable {σ : Space S} (h1 : σ.Axiom1) (h2 : σ.Axiom2) (h3 : σ.Axiom3) (h4 : σ.Axiom4)
  (h5 : σ.Axiom5)
include h1 h2 h3 h4 h5

/-- **Theorem 11.** `(R₁ + ⋯ + Rₙ)'` has the Heine–Borel property. (No proof printed.) -/
theorem fa_theorem11 (F : Finset (Set S)) (hF : ↑F ⊆ σ.region) :
    σ.HeineBorel (σ.cl (⋃₀ ↑F)) := by
  sorry

/-- **Theorem 12.** Every closed bounded set has the Heine–Borel property. -/
theorem fa_theorem12 {M : Set S} (hc : σ.IsClosedM M) (hb : σ.IsBoundedM M) :
    σ.HeineBorel M := by
  sorry

/-- **Theorem 13.** Every infinite bounded set has a limit point. (Moore: "see Hausdorff,
*Grundzüge*, p. 231"; no proof printed.) -/
theorem fa_theorem13 {M : Set S} (hi : M.Infinite) (hb : σ.IsBoundedM M) :
    ∃ P, σ.IsLimitPt P M := by
  sorry

/-- **Theorem 14.** If `M₁, M₂, …` are bounded and `Mₙ ⊇ M'ₙ₊₁`, the `Mₙ` have a common point,
and the set of common points is closed.
**Check:** the proof begins "For each `n`, `Mₙ` contains at least one point", which is not a
hypothesis. With every `Mₙ = ∅` the printed statement fails. The hypothesis `hne` is added here;
refute the printed form (without `hne`), or explain why it is not needed. -/
theorem fa_theorem14 {M : ℕ → Set S} (hb : ∀ n, σ.IsBoundedM (M n))
    (hsub : ∀ n, σ.cl (M (n + 1)) ⊆ M n) (hne : ∀ n, (M n).Nonempty) :
    (⋂ n, M n).Nonempty ∧ σ.IsClosedM (⋂ n, M n) := by
  sorry

/-- **Theorem 15.** Two distinct points of a domain are joined by an arc in the domain.
(Moore's proof by nested simple chains, pp. 136–139.) -/
theorem fa_theorem15 {M : Set S} (hM : σ.IsDomain M) {A B : S} (hA : A ∈ M) (hB : B ∈ M)
    (hAB : A ≠ B) : ∃ C ⊆ M, σ.IsArc A B C := by
  sorry

/-- **Theorem 16.** Two points of a region are joined by an arc in the region; two points without
the region are joined by an arc without it. (No proof printed.) -/
theorem fa_theorem16 {R : Set S} (hR : R ∈ σ.region) :
    (∀ A ∈ R, ∀ B ∈ R, A ≠ B → ∃ C ⊆ R, σ.IsArc A B C) ∧
      (∀ A ∈ σ.ext R, ∀ B ∈ σ.ext R, A ≠ B → ∃ C ⊆ σ.ext R, σ.IsArc A B C) := by
  sorry

end Sec4

/-! ## §4. The bridge to topology

Under Axioms 1–4 and 5₁, the regions generate a topology in which Moore's notions are the usual
ones. In the application (Moore 1925, Theorem 21) the space is a decomposition space that already
carries a topology; this section is what lets the arc facts below come from `[0, 1]`. -/

section Bridge

variable {σ : Space S} (h1 : σ.Axiom1) (h2 : σ.Axiom2) (h3 : σ.Axiom3) (h4 : σ.Axiom4)
  (h51 : σ.Axiom5₁)

/-- The topology generated by the regions. -/
def Space.topology (σ : Space S) : TopologicalSpace S := TopologicalSpace.generateFrom σ.region

include h1 h2 h3 h4 h51

theorem isTopologicalBasis_region :
    @TopologicalSpace.IsTopologicalBasis S σ.topology σ.region := by
  sorry

theorem isLimitPt_iff {P : S} {M : Set S} :
    σ.IsLimitPt P M ↔ @AccPt S σ.topology P (Filter.principal M) := by
  sorry

theorem isClosedM_iff {M : Set S} : σ.IsClosedM M ↔ @IsClosed S σ.topology M := by
  sorry

theorem isConn_iff {M : Set S} : σ.IsConn M ↔ @IsPreconnected S σ.topology M := by
  sorry

theorem heineBorel_iff {M : Set S} : σ.HeineBorel M ↔ @IsCompact S σ.topology M := by
  sorry

/-- The generated topology is metrizable (T2, regular, second countable: Urysohn). -/
theorem metrizable : @TopologicalSpace.MetrizableSpace S σ.topology := by
  sorry

/-- Moore's closure `M'` is the topological closure. -/
theorem cl_eq_closure (M : Set S) : σ.cl M = @closure S σ.topology M := by
  sorry

end Bridge

/-! ## §5. Arcs (F.A. §5, p. 139: "it is possible to prove Theorems 2–9 of §4 of Lennes' paper")

Replace Lennes's Theorems 2–9 (not supplied) by the arc characterization in a metrizable space:
a Lennes–Moore arc from `A` to `B` is exactly a homeomorphic image of `[0, 1]` with `0 ↦ A`,
`1 ↦ B`. Use Nadler, *Continuum Theory*, Ch. 6: a nondegenerate metric continuum with exactly two
non-cut points is an arc. Here every point other than `A`, `B` is a cut point (otherwise `C − P`
would be a connected proper subset containing `A` and `B`), and every nondegenerate continuum has
at least two non-cut points. -/

section Arcs

/-- **Arc characterization (topological form).** In a metrizable space, a compact connected set
containing `A ≠ B` with no connected proper subset containing both is the image of an embedding
of `[0, 1]` with `0 ↦ A` and `1 ↦ B`; and conversely. -/
theorem isIrreducibleConnected_iff_arc {X : Type*} [TopologicalSpace X]
    [TopologicalSpace.MetrizableSpace X] {A B : X} (hAB : A ≠ B) {C : Set X} :
    (IsCompact C ∧ IsConnected C ∧ A ∈ C ∧ B ∈ C ∧
        ∀ H ⊆ C, H ≠ C → A ∈ H → B ∈ H → ¬ IsConnected H) ↔
      ∃ f : unitInterval → X, Topology.IsEmbedding f ∧ range f = C ∧ f 0 = A ∧ f 1 = B := by
  sorry

variable {σ : Space S} (h1 : σ.Axiom1) (h2 : σ.Axiom2) (h3 : σ.Axiom3) (h4 : σ.Axiom4)
  (h5 : σ.Axiom5)
include h1 h2 h3 h4 h5

/-- Moore arcs are arcs. -/
theorem isArc_iff {A B : S} {C : Set S} :
    σ.IsArc A B C ↔ A ≠ B ∧ ∃ f : unitInterval → S,
      @Topology.IsEmbedding _ _ _ σ.topology f ∧ range f = C ∧ f 0 = A ∧ f 1 = B := by
  sorry

/-- The facts listed on p. 139 (unnumbered), as used later in F.A. and in Moore 1919, 1925:
(a) a point `X` of the arc `AB` other than an endpoint splits it into arcs `AX`, `XB` meeting only
in `X`; (b) two interior points `X`, `Y` bound exactly one sub-arc (the *interval* `XY`);
(c) first and last points of `AB` on a closed set `K` meeting it; (d) limit points on an arc via
intervals. State each as its own lemma (the shapes are left to you); the order and betweenness on
`AB` should be those of `[0, 1]` transported by `isArc_iff`. -/
theorem fa_sec5_arc_split {A B X : S} {C : Set S} (hC : σ.IsArc A B C) (hX : X ∈ C)
    (hXA : X ≠ A) (hXB : X ≠ B) :
    ∃ C₁ C₂, σ.IsArc A X C₁ ∧ σ.IsArc X B C₂ ∧ C₁ ∪ C₂ = C ∧ C₁ ∩ C₂ = {X} := by
  sorry

/-- p. 140 (unnumbered): two distinct points `A`, `B` of a simple closed curve `J` split it into
exactly two arcs from `A` to `B`, meeting only in `A` and `B`. -/
theorem fa_scc_two_arcs {J : Set S} (hJ : σ.IsSCC J) {A B : S} (hA : A ∈ J) (hB : B ∈ J)
    (hAB : A ≠ B) :
    ∃ C₁ C₂, σ.IsArc A B C₁ ∧ σ.IsArc A B C₂ ∧ C₁ ∩ C₂ = {A, B} ∧ C₁ ∪ C₂ = J ∧
      ∀ C ⊆ J, σ.IsArc A B C → C = C₁ ∨ C = C₂ := by
  sorry

/-- **Theorem 17.** The exterior of a region contains an infinite set with no limit point.
("A consequence of Axiom 5 and Theorem 13.") -/
theorem fa_theorem17 {R : Set S} (hR : R ∈ σ.region) :
    ∃ M ⊆ σ.ext R, M.Infinite ∧ ∀ P, ¬ σ.IsLimitPt P M := by
  sorry

/-- **Theorem 18.** The exterior of a region is not bounded. (No proof printed.) -/
theorem fa_theorem18 {R : Set S} (hR : R ∈ σ.region) : ¬ σ.IsBoundedM (σ.ext R) := by
  sorry

/-- **Theorem 19.** Every region has at least one boundary point. -/
theorem fa_theorem19 {R : Set S} (hR : R ∈ σ.region) : (σ.bdry R).Nonempty := by
  sorry

end Arcs

end HPC.Moore
