import HPC.Fold.Target76
import HPC.Fold.Audit71
import HPC.Fold.Audit72

/-!
# The extension law at the stored witnesses, put to the kernel

Batch 76 §2.3 asks for `ExtendsSubBand` (`HPC/Fold/Target76.lean`) to be kernel-checked, in the
manner of `HPC/Fold/Audit71.lean`, at the stored witnesses of the earlier batches that are short
enough. This file does the five short ones. Six longer ones (5742 to 14 000 links), whose arms
outrun the kernel's default thread stack, are in the library `Audit76Long` (`Audit76Long/*.lean`),
built with a larger thread stack (`lake build Audit76Long`) and otherwise identical in form. The
33 462- and 80 783-link witnesses of spans thirteen and fourteen are not kernel-checked: the kernel's
evaluation of the folds on arms of that length exhausted the 64 GB of memory available; they are
checked by `ext76.py` only (`check76-least.log`).

| witness | links | basepoint | band | least legs | here |
|---|---|---|---|---|---|
| `witness-batch72-min.txt` (the pair of `Audit72`) | 78 | 1 | `[3, 9]` | 1 | witness, and the whole predicate by `decide +kernel` |
| `witness-batch71-min.txt` (the pair of `Audit71`) | 290 | 104 | `[2, 9]` | 3 | witness; the whole predicate by `decide +kernel`; its failure at two legs by `decide +kernel` |
| `witness-batch75-span9-k4.txt` | 2378 | 343 | `[0, 9]` | 4 | witness |
| `witness-batch75-span10-k4.txt` | 2379 | 343 | `[0, 10]` | 4 | witness |
| `witness-batch75-span10-k5.txt` | 3000 | 1256 | `[0, 10]` | 5 | witness |

*What is checked.* For each, `extendsSubBand_of_witness` is applied to the sub-band, the sub-band
walk and the appended level found by `ext76.py` (a search that shares no code with the census), and
every one of its seven hypotheses — the band inequalities, the targets' range, the appended level
differing from the last level of `w'`, and the four folds — is discharged by `decide +kernel`, the
folds through `foldsB`, which `foldsB_iff` proves equal to `FoldsOnto`. For the two pairs of
`Audit71` and `Audit72` the sequence is also proved equal to theirs, so their faithfulness
(`IsCrookedIvF`, proved there by the kernel) is carried over; for the others faithfulness is the
census's and `check75.py`'s, and is not re-proved here. The least leg count is the census's and
`ext76.py`'s (a walk of that many legs folds both arms, none of fewer does); it is not a Lean
statement, and `ExtendsSubBand` does not mention it.

*The decision procedure itself.* At the two short pairs the whole predicate — the finite search
`extendsSubBandB`, over every sub-band, start, target list and appended level — is also evaluated by
the kernel, and at the 290-link pair it is evaluated to *false* one leg lower, so the statement is
not vacuous at the least leg count: `ExtendsSubBand ρ 104 2 9 2` fails, as it must, since a
two-leg `w` would be a walk of fewer legs than the least.

*A convention.* `ExtendsSubBand … k` asks for `k − 1` targets; at `k = 0` that is `0 − 1 = 0` in
`ℕ`, the same as at `k = 1`. The statement is meant for `k ≥ 1`, and is used here only there.
-/

set_option maxRecDepth 100000000
set_option maxHeartbeats 0

namespace HPC.Fold.Audit76

/-! ## The 78-link pair of `Audit72` -/

namespace P78

/-- The 78 links of `ρ` of `witness-batch72-min.txt`, one base-sixteen digit each, link `j` the `j`-th
digit. -/
def rhoNat : ℕ := 0x987876787676567678767656765654565676567678767656765654565676565456545434545654

/-- The point sequence of `witness-batch72-min.txt`. -/
def rho : Fin 78 → ℤ := fun j => (((rhoNat >>> (4 * j.val)) &&& 15 : ℕ) : ℤ)

/-- The sequence is the one of `Audit72`. -/
theorem rho_eq : rho = Audit72.rho78 :=
  funext (by decide +kernel : ∀ j : Fin 78, rho j = Audit72.rho78 j)

/-- The pair is faithful: `Audit72.faithful`, carried over. -/
theorem faithful : IsCrookedIvF rho Audit72.sig78 := rho_eq ▸ Audit72.faithful

/-- The basepoint 1. -/
def basept : Fin 78 := ⟨1, by omega⟩

/-- **The extension law at basepoint 1** (band `[3, 9]`, least leg count 1). The least leg count here is one, so this basepoint is outside the conjecture's range (`k ≥ 3`); it is checked because the commission names the witness.
The witness: `L' = 3`, `H' = 5`, `w'` from `4` through `[]`, the appended leg to
`8`. -/
theorem extendsSubBand : ExtendsSubBand rho basept 3 9 1 :=
  extendsSubBand_of_witness 3 5 4 8 [] (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel)

/-- The same, with no witness supplied: the kernel runs the whole search `extendsSubBandB`. -/
theorem extendsSubBand_search : ExtendsSubBand rho basept 3 9 1 := by decide +kernel

end P78

/-! ## The 290-link pair of `Audit71` -/

namespace P290

/-- The 290 links of `ρ` of `witness-batch71-min.txt`, one base-sixteen digit each, link `j` the `j`-th
digit. -/
def rhoNat : ℕ := 0x23434443444555444345456545656665554565454345456545556665654565666566656545656665554565454345456545556665654565454344455544434443444555444345456545656665554565454345456545556665654565666567678767656665654565666565456544434545654565666565456567656767876765676565456567656767776765676787678789

/-- The point sequence of `witness-batch71-min.txt`. -/
def rho : Fin 290 → ℤ := fun j => (((rhoNat >>> (4 * j.val)) &&& 15 : ℕ) : ℤ)

/-- The sequence is the one of `Audit71`. -/
theorem rho_eq : rho = Audit71.rho290 :=
  funext (by decide +kernel : ∀ j : Fin 290, rho j = Audit71.rho290 j)

/-- The pair is faithful: `Audit71.faithful`, carried over. -/
theorem faithful : IsCrookedIvF rho Audit71.sig290 := rho_eq ▸ Audit71.faithful

/-- The basepoint 104. -/
def basept : Fin 290 := ⟨104, by omega⟩

/-- **The extension law at basepoint 104** (band `[2, 9]`, least leg count 3).
The witness: `L' = 3`, `H' = 7`, `w'` from `4` through `[7, 3]`, the appended leg to
`8`. -/
theorem extendsSubBand : ExtendsSubBand rho basept 2 9 3 :=
  extendsSubBand_of_witness 3 7 4 8 [7, 3] (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel)

/-- The same, with no witness supplied: the kernel runs the whole search `extendsSubBandB`. -/
theorem extendsSubBand_search : ExtendsSubBand rho basept 2 9 3 := by decide +kernel

/-- **One leg lower the extension law fails**, by exhaustion of the whole search: no sub-band,
no one-target `w'` and no appended level serve. So at this basepoint the least leg count is where
the law begins to hold. -/
theorem not_extendsSubBand_two : ¬ ExtendsSubBand rho basept 2 9 2 := by decide +kernel

end P290

