import HPC.Moore.Basic

/-!
# Moore, F.A. (1916): the bridge to topology (batch 137, item D)

The regions generate a topology `σ.topology`. The skeleton's section heading assumes Axioms 1–4
and 5₁; each statement below carries only what its proof uses (shape change, recorded here and in
the report):

| statement | axioms used |
|---|---|
| `heineBorel_iff` | none |
| `isClosedM_iff_cl_subset` | none |
| `isTopologicalBasis_region`, `isLimitPt_iff`, `cl_eq_closure`, `isClosedM_iff`, `isConn_iff` | Axiom 1 |
| `t1Space`, `regularSpace` (hence T2, T3) | Axiom 1 |
| `secondCountable`, `metrizable` | Axioms 1, 3, 5₁ |

Axioms 3 and 5₁ enter metrizability only through Theorem 4: they exclude isolated points, which is
what makes the fundamental regions `K₁, K₂, …` a countable basis. Without them the fundamental
sequence need not be a basis (a singleton region is not reached by Axiom 1 (2)). Axioms 2 and 4 are
not needed for any identification.
-/

namespace HPC.Moore

open Set Topology TopologicalSpace Space

variable {S : Type*} {σ : Space S}

/-- The topology generated by the regions. -/
def Space.topology (σ : Space S) : TopologicalSpace S := TopologicalSpace.generateFrom σ.region

theorem isOpen_region {R : Set S} (hR : R ∈ σ.region) : @IsOpen S σ.topology R :=
  TopologicalSpace.isOpen_generateFrom_of_mem hR

/-- `M` is closed in Moore's sense iff it contains `M'`. *Axioms used: none.* -/
theorem isClosedM_iff_cl_subset {M : Set S} : σ.IsClosedM M ↔ σ.cl M ⊆ M := by
  refine ⟨fun h X hX => ?_, fun h X hX => h (mem_cl_of_isLimitPt hX)⟩
  rcases hX with hX | hX
  · exact hX
  · by_contra hXM
    exact hXM (h X (isLimitPt_of_mem_bdry hX hXM))

/-- **Heine–Borel is compactness.** *Axioms used: none* (Alexander's subbasis theorem gives one
direction; regions are open, which gives the other). -/
theorem heineBorel_iff {M : Set S} : σ.HeineBorel M ↔ @IsCompact S σ.topology M := by
  letI := σ.topology
  constructor
  · intro h
    refine isCompact_generateFrom rfl fun P hP hMP => ?_
    obtain ⟨F, hFP, hMF⟩ := h P ⟨hP, hMP⟩
    exact ⟨↑F, hFP, F.finite_toSet, hMF⟩
  · rintro h K ⟨hK, hMK⟩
    obtain ⟨b, hbK, hbfin, hMb⟩ := h.elim_finite_subcover_image (b := K) (c := id)
      (fun R hR => isOpen_region (hK hR)) (by simpa [sUnion_eq_biUnion] using hMK)
    refine ⟨hbfin.toFinset, by simpa using hbK, ?_⟩
    simpa [sUnion_eq_biUnion] using hMb

section Axiom1

variable (h1 : σ.Axiom1)
include h1

/-- **The regions form a basis** (Axiom 1: Theorem 6 and condition (1)). -/
theorem isTopologicalBasis_region : @IsTopologicalBasis S σ.topology σ.region := by
  letI := σ.topology
  refine ⟨fun t₁ ht₁ t₂ ht₂ x hx => fa_theorem6 h1 ht₁ ht₂ hx.1 hx.2, ?_, rfl⟩
  refine eq_univ_of_forall fun x => ?_
  obtain ⟨R, hR, hxR⟩ := exists_region_mem h1 x
  exact ⟨R, hR, hxR⟩

theorem mem_nhds_iff_region {P : S} {U : Set S} :
    U ∈ @nhds S σ.topology P ↔ ∃ R ∈ σ.region, P ∈ R ∧ R ⊆ U := by
  letI := σ.topology
  exact (isTopologicalBasis_region h1).mem_nhds_iff

theorem isOpen_iff_region {U : Set S} :
    @IsOpen S σ.topology U ↔ ∀ P ∈ U, ∃ R ∈ σ.region, P ∈ R ∧ R ⊆ U := by
  letI := σ.topology
  rw [isOpen_iff_mem_nhds]
  exact forall₂_congr fun P _ => mem_nhds_iff_region h1

/-- **Moore's limit point is the accumulation point.** *Axioms used: 1.* -/
theorem isLimitPt_iff {P : S} {M : Set S} :
    σ.IsLimitPt P M ↔ @AccPt S σ.topology P (Filter.principal M) := by
  letI := σ.topology
  rw [accPt_iff_nhds]
  constructor
  · intro h U hU
    obtain ⟨R, hR, hPR, hRU⟩ := (mem_nhds_iff_region h1).mp hU
    obtain ⟨y, hyM, hyR, hyP⟩ := h R hR hPR
    exact ⟨y, ⟨hRU hyR, hyM⟩, hyP⟩
  · intro h R hR hPR
    obtain ⟨y, ⟨hyR, hyM⟩, hyP⟩ := h R ((isOpen_region hR).mem_nhds hPR)
    exact ⟨y, hyM, hyR, hyP⟩

/-- **Moore's `M'` is the topological closure.** *Axioms used: 1.* -/
theorem cl_eq_closure (M : Set S) : σ.cl M = @closure S σ.topology M := by
  letI := σ.topology
  ext X
  rw [(isTopologicalBasis_region h1).mem_closure_iff]
  constructor
  · rintro (hX | hX) R hR hXR
    · exact ⟨X, hXR, hX⟩
    · exact (hX R hR hXR).1
  · intro h
    by_cases hXM : X ∈ M
    · exact Or.inl hXM
    · exact Or.inr fun R hR hXR => ⟨h R hR hXR, ⟨X, hXR, hXM⟩⟩

/-- **Moore's closed is closed.** *Axioms used: 1.* -/
theorem isClosedM_iff {M : Set S} : σ.IsClosedM M ↔ @IsClosed S σ.topology M := by
  letI := σ.topology
  rw [isClosedM_iff_cl_subset, cl_eq_closure h1, closure_subset_iff_isClosed]

/-- **Moore's connected is preconnected.** *Axioms used: 1.* (Moore's definition allows the empty
set, as does `IsPreconnected`.) -/
theorem isConn_iff {M : Set S} : σ.IsConn M ↔ @IsPreconnected S σ.topology M := by
  letI := σ.topology
  constructor
  · intro h u v hu hv hMuv ⟨a, haM, hau⟩ ⟨b, hbM, hbv⟩
    by_contra hne
    rw [not_nonempty_iff_eq_empty] at hne
    have hbu : b ∉ u := fun hbu => (eq_empty_iff_forall_notMem.mp hne) b ⟨hbM, hbu, hbv⟩
    rcases h (M ∩ u) (M \ u) (inter_union_diff M u) disjoint_sdiff_inter.symm ⟨a, haM, hau⟩
        ⟨b, hbM, hbu⟩ with ⟨x, ⟨-, hxu⟩, hx⟩ | ⟨x, ⟨hxM, hxu⟩, hx⟩
    · obtain ⟨y, ⟨hyu, -, hyu'⟩, -⟩ :=
        accPt_iff_nhds.mp ((isLimitPt_iff h1).mp hx) u (hu.mem_nhds hxu)
      exact hyu' hyu
    · have hxv : x ∈ v := (hMuv hxM).resolve_left hxu
      obtain ⟨y, ⟨hyv, hyM, hyu⟩, -⟩ :=
        accPt_iff_nhds.mp ((isLimitPt_iff h1).mp hx) v (hv.mem_nhds hxv)
      exact (eq_empty_iff_forall_notMem.mp hne) y ⟨hyM, hyu, hyv⟩
  · intro h A B hAB hdis hA hB
    by_contra hc
    push_neg at hc
    obtain ⟨hcA, hcB⟩ := hc
    have hAu : A ⊆ (closure B)ᶜ := fun x hxA hx => by
      rw [← cl_eq_closure h1] at hx
      rcases hx with hx | hx
      · exact disjoint_left.mp hdis hxA hx
      · exact hcA x hxA (isLimitPt_of_mem_bdry hx (disjoint_left.mp hdis hxA))
    have hBv : B ⊆ (closure A)ᶜ := fun x hxB hx => by
      rw [← cl_eq_closure h1] at hx
      rcases hx with hx | hx
      · exact disjoint_left.mp hdis hx hxB
      · exact hcB x hxB (isLimitPt_of_mem_bdry hx (disjoint_right.mp hdis hxB))
    obtain ⟨z, hzM, hzu, hzv⟩ := h _ _ isClosed_closure.isOpen_compl
      isClosed_closure.isOpen_compl (hAB ▸ union_subset_union hAu hBv)
      (hA.mono fun x hx => ⟨hAB ▸ Or.inl hx, hAu hx⟩)
      (hB.mono fun x hx => ⟨hAB ▸ Or.inr hx, hBv hx⟩)
    rw [← hAB] at hzM
    rcases hzM with hz | hz
    · exact hzv (subset_closure hz)
    · exact hzu (subset_closure hz)

/-- A domain is a connected open set. *Axioms used: 1.* -/
theorem isDomain_iff {M : Set S} :
    σ.IsDomain M ↔ @IsOpen S σ.topology M ∧ @IsPreconnected S σ.topology M := by
  rw [Space.IsDomain, isConn_iff h1, isOpen_iff_region h1, and_comm]

/-- The exterior of a set is open (`M'` is closed). *Axioms used: 1.* -/
theorem isOpen_ext (M : Set S) : @IsOpen S σ.topology (σ.ext M) := by
  letI := σ.topology
  rw [Space.ext, cl_eq_closure h1]
  exact isClosed_closure.isOpen_compl

/-- **T1** (Theorem 3). *Axioms used: 1.* -/
theorem t1Space : @T1Space S σ.topology := by
  letI := σ.topology
  rw [t1Space_iff_exists_open]
  intro x y hxy
  obtain ⟨R, hR, hxR, hdis⟩ := fa_theorem3 h1 (finite_singleton y) (fun h => hxy h)
  exact ⟨R, isOpen_region hR, hxR, fun h => disjoint_left.mp hdis h rfl⟩

/-- **Regular** (Axiom 1 (2): regions about `P` with their closures inside a given region).
*Axioms used: 1.* -/
theorem regularSpace : @RegularSpace S σ.topology := by
  letI := σ.topology
  refine RegularSpace.of_exists_mem_nhds_isClosed_subset fun x s hs => ?_
  obtain ⟨R, hR, hxR, hRs⟩ := (mem_nhds_iff_region h1).mp hs
  obtain ⟨K, hK, hxK, hcl⟩ := exists_region_cl_subset h1 hR hxR
  rw [cl_eq_closure h1] at hcl
  exact ⟨closure K, Filter.mem_of_superset ((isOpen_region hK).mem_nhds hxK) subset_closure,
    isClosed_closure, hcl.trans hRs⟩

theorem t2Space : @T2Space S σ.topology := by
  letI := σ.topology
  haveI := t1Space h1
  haveI := regularSpace h1
  infer_instance

end Axiom1

section Axiom135

variable (h1 : σ.Axiom1) (h3 : σ.Axiom3) (h51 : Space.Axiom5₁ (S := S))
include h1 h3 h51

/-- **The fundamental regions form a basis.** *Axioms used: 1, 3, 5₁* (Theorem 4: a region about
`P` has a second point, so Axiom 1 (2) applies to it). -/
theorem isTopologicalBasis_fund {K : ℕ → Set S} (hK : σ.IsFund K) :
    @IsTopologicalBasis S σ.topology (range K) := by
  letI := σ.topology
  refine isTopologicalBasis_of_isOpen_of_nhds ?_ fun a u hau hu => ?_
  · rintro _ ⟨n, rfl⟩
    exact isOpen_region (hK.1 n)
  · obtain ⟨R, hR, haR, hRu⟩ := (isOpen_iff_region h1).mp hu a hau
    obtain ⟨P', hP', hne⟩ := exists_ne_of_region h1 h3 h51 hR haR
    obtain ⟨n, -, han, hcl⟩ := hK.exists_late hR haR hP' hne.symm 0
    exact ⟨K n, ⟨n, rfl⟩, han, fun x hx => hRu (hcl (subset_cl _ hx)).1⟩

theorem secondCountable : @SecondCountableTopology S σ.topology := by
  letI := σ.topology
  have hK' : ∃ K, σ.IsFund K := h1
  obtain ⟨K, hK⟩ := hK'
  exact (isTopologicalBasis_fund h1 h3 h51 hK).secondCountableTopology (countable_range K)

/-- **The generated topology is metrizable** (T1 and regular, hence T3; second countable; then
Urysohn's metrization theorem). *Axioms used: 1, 3, 5₁.* -/
theorem metrizable : @TopologicalSpace.MetrizableSpace S σ.topology := by
  letI := σ.topology
  haveI := t1Space h1
  haveI := regularSpace h1
  haveI := secondCountable h1 h3 h51
  exact TopologicalSpace.metrizableSpace_of_t3_secondCountable S

end Axiom135

/-! ### Axiom 4: compactness of closures of regions; boundedness -/

section Axiom4

variable (h1 : σ.Axiom1) (h4 : σ.Axiom4)
include h1 h4

/-- `R'` is compact for a region `R` (Axiom 4). -/
theorem isCompact_closure_region {R : Set S} (hR : R ∈ σ.region) :
    @IsCompact S σ.topology (@closure S σ.topology R) := by
  rw [← cl_eq_closure h1, ← heineBorel_iff]
  exact h4 R hR

/-- `(R₁ + ⋯ + Rₙ)'` is compact. -/
theorem isCompact_cl_sUnion {F : Finset (Set S)} (hF : ↑F ⊆ σ.region) :
    @IsCompact S σ.topology (σ.cl (⋃₀ ↑F)) := by
  letI := σ.topology
  rw [cl_eq_closure h1, sUnion_eq_biUnion, F.finite_toSet.closure_biUnion]
  exact F.finite_toSet.isCompact_biUnion fun R hR => isCompact_closure_region h1 h4 (hF hR)

/-- A bounded set lies in a compact set. -/
theorem exists_isCompact_of_isBoundedM {M : Set S} (hM : σ.IsBoundedM M) :
    ∃ C, @IsCompact S σ.topology C ∧ M ⊆ C := by
  obtain ⟨F, hF, hMF⟩ := hM
  exact ⟨_, isCompact_cl_sUnion h1 h4 hF, hMF⟩

/-- The closure of a bounded set is compact. -/
theorem isCompact_closure_of_isBoundedM {M : Set S} (hM : σ.IsBoundedM M) :
    @IsCompact S σ.topology (@closure S σ.topology M) := by
  letI := σ.topology
  haveI := t2Space h1
  obtain ⟨C, hC, hMC⟩ := exists_isCompact_of_isBoundedM h1 h4 hM
  exact hC.of_isClosed_subset isClosed_closure (closure_minimal hMC hC.isClosed)

end Axiom4

/-- A compact set is bounded (it is covered by finitely many regions). *Axioms used: 1.* -/
theorem isBoundedM_of_isCompact (h1 : σ.Axiom1) {M : Set S} (hM : @IsCompact S σ.topology M) :
    σ.IsBoundedM M := by
  rw [← heineBorel_iff] at hM
  obtain ⟨F, hF, hMF⟩ := hM σ.region ⟨subset_rfl, fun x _ => by
    obtain ⟨R, hR, hxR⟩ := exists_region_mem h1 x
    exact ⟨R, hR, hxR⟩⟩
  exact ⟨F, hF, hMF.trans (subset_cl _)⟩

end HPC.Moore
